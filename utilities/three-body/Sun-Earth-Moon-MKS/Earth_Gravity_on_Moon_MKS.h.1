void Earth_Gravity_on_Moon_MKS(){

// vector from Moon to Earth
    RM_E.x= -(moon.x-earth.x);
    RM_E.y= -(moon.y-earth.y);
    RM_E.z= -(moon.z-earth.z);
// vector from Moon to Earth

    long double d_ME = sqrt(RM_E.x * RM_E.x + RM_E.y * RM_E.y + RM_E.z * RM_E.z);

    long double fE_M = (G_MKS * moon.m * earth.m) / (d_ME * d_ME * d_ME);

    moon.ax += fE_M * RM_E.x / moon.m;
    moon.ay += fE_M * RM_E.y / moon.m;
    moon.az += fE_M * RM_E.z / moon.m;

}
