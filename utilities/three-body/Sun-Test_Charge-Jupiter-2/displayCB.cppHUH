/*
      p[0] = ( float ) xy[0+point*2];
      p[1] = ( float ) xy[1+point*2];
*/
/*
      p[0] = ( float ) JX[0+point*2] / 1e11;
      p[1] = ( float ) JY[1+point*2] / 1e11;
*/
/*
      p[0] = ( float ) SX[i] / 1e8;
      p[1] = ( float ) SY[i] / 1e8;
