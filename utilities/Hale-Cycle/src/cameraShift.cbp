<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="cameraShift" />
		<Option pch_mode="2" />
		<Option compiler="gcc-mingw64" />
		<Build>
			<Target title="Release">
				<Option output="../bin/cameraShift" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../bin" />
				<Option object_output="objs/" />
				<Option type="1" />
				<Option compiler="gcc-mingw64" />
				<Option use_console_runner="0" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-DFREEGLUT_STATIC" />
			<Add directory="./freeglut/include" />
		</Compiler>
		<Linker>
			<Add option="-static-libstdc++" />
			<Add option="-static-libgcc" />
			<Add option="-static" />
			<Add library="freeglut_static" />
			<Add library="glu32" />
			<Add library="opengl32" />
			<Add library="winmm" />
			<Add library="gdi32" />
			<Add directory="./freeglut/lib/x64" />
		</Linker>
		<Unit filename="Matrices.cpp" />
		<Unit filename="Matrices.h" />
		<Unit filename="OrbitCamera.cpp" />
		<Unit filename="OrbitCamera.h" />
		<Unit filename="Quaternion.h" />
		<Unit filename="Sphere.cpp" />
		<Unit filename="Sphere.h" />
		<Unit filename="Timer.cpp" />
		<Unit filename="Timer.h" />
		<Unit filename="Vectors.h" />
		<Unit filename="animUtils.cpp" />
		<Unit filename="animUtils.h" />
		<Unit filename="main.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
