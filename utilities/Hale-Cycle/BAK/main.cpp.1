float zoom = 1.0f;
void mouseWheel(int wheel, int direction, int x, int y) {
    if (direction > 0) {
        zoom += 0.03f; // Zoom in
    } else {
        zoom -= 0.03f; // Zoom out
    }
    if (zoom < 0.1f) zoom = 0.1f; // Prevent inversion/disappearance
    glutPostRedisplay();
}
